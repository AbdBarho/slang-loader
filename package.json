{
  "name": "slang-loader",
  "version": "0.0.1",
  "description": "Compile Slang shaders to WGSL at build time, for Vite, webpack, Rollup, esbuild and more.",
  "author": "Abdullah Barhoum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdBarho/slang-loader.git"
  },
  "homepage": "https://github.com/AbdBarho/slang-loader#readme",
  "bugs": "https://github.com/AbdBarho/slang-loader/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "default": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "default": "./dist/rollup.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "default": "./dist/rolldown.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "default": "./dist/webpack.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "default": "./dist/rspack.mjs"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.mts",
      "default": "./dist/rsbuild.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "default": "./dist/esbuild.mjs"
    },
    "./farm": {
      "types": "./dist/farm.d.mts",
      "default": "./dist/farm.mjs"
    },
    "./bun": {
      "types": "./dist/bun.d.mts",
      "default": "./dist/bun.mjs"
    },
    "./unloader": {
      "types": "./dist/unloader.d.mts",
      "default": "./dist/unloader.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "fetch-wasm": "node scripts/fetch-wasm.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run fetch-wasm && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "slang",
    "wgsl",
    "webgpu",
    "shader",
    "unplugin",
    "vite-plugin",
    "webpack-plugin",
    "rollup-plugin",
    "esbuild-plugin",
    "rspack-plugin"
  ],
  "dependencies": {
    "unplugin": "^3.3.0"
  }
}
